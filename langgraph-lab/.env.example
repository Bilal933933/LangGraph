# انسخ إلى .env ثم ضع مفتاحك
# GOOGLE_API_KEY=AIza...
# GEMINI_MODEL=gemini-3.5-flash-lite
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
APP_NAME=langgraph-lab
# رابط Postgres المحلي: جداول التطبيق عبر SQLAlchemy + جداول لقطات LangGraph عبر setup()
# DATABASE_URL=postgresql+psycopg://lab:lab123@localhost:5432/langgraph_lab
# سر JWT للإنتاج (32 حرفًا على الأقل)
# JWT_SECRET=change-me-32-chars-minimum-secret
# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_DAYS=30
# سجل مراحل الرد (ملف محلي logs/app.log)
# LOG_LEVEL=INFO
# LOG_DIR=logs
