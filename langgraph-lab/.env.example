# انسخ إلى .env ثم ضع مفاتيحك: cp .env.example .env
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
APP_NAME=langgraph-lab
# --- Postgres (يقرأها docker-compose.yml + DATABASE_URL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-dotenv
POSTGRES_DB=langgraph_lab
POSTGRES_PORT=5432
# رابط Postgres المحلي: جداول التطبيق عبر Alembic + جداول لقطات LangGraph عبر setup()
DATABASE_URL=postgresql+psycopg://postgres:change-me-in-dotenv@localhost:5432/langgraph_lab
# --- الواجهة المسموح لها بمناداة API (فاصلة بين الأصول) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# --- حدود المعدل (طلب/دقيقة: دردشة مسجلين، ضيوف، مصادقة) ---
# CHAT_RPM=30
# CHAT_GUEST_RPM=10
# AUTH_RPM=10
# --- سقف الرموز اليومي لكل مستخدم/ضيف (0 = بلا سقف) ---
# DAILY_TOKEN_CAP=200000
# سر JWT للإنتاج (32 حرفًا على الأقل)
# JWT_SECRET=change-me-32-chars-minimum-secret
# بيئة التشغيل: development افتراضيًا؛ production يرفض الإقلاع بسر التطوير
# APP_ENV=development
# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_DAYS=30
# سجل مراحل الرد (ملف محلي logs/app.log)
# LOG_LEVEL=INFO
# LOG_DIR=logs
